@model List<ProyectoWong.Models.Monitoreo.ProcesoOrdenViewModel>
@{
    Layout = null;
    ViewBag.Title = "Monitoreo de Producción - SIV";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            :root {
                --color-amarillo: #f3eeb6;
                --color-verde-claro: #d4db74;
                --color-verde: #9abf17;
                --color-aqua: #84bf93;
                --color-aqua-claro: #aed9c5;
                --color-azul-claro: #ddecf1;
                --color-texto: #4a5568;
                --color-texto-claro: #718096;
                --color-blanco-glass: rgba(255, 255, 255, 0.85);
            }

            body {
                font-family: 'Nunito', sans-serif;
                background: linear-gradient(135deg, var(--color-azul-claro) 0%, var(--color-amarillo) 50%, var(--color-aqua-claro) 100%);
                min-height: 100vh;
                margin: 0;
                position: relative;
                overflow-x: hidden;
                color: var(--color-texto);
            }

            @@keyframes float {
                0%, 100% {
                    transform: translateY(0px) scale(1);
                }

                50% {
                    transform: translateY(-20px) scale(1.05);
                }
            }

            .bg-blob {
                position: fixed;
                border-radius: 50%;
                filter: blur(60px);
                z-index: 0;
                opacity: 0.6;
                animation: float 8s ease-in-out infinite;
            }

            .blob-1 {
                width: 400px;
                height: 400px;
                background: var(--color-verde-claro);
                top: -100px;
                left: -100px;
            }

            .blob-2 {
                width: 350px;
                height: 350px;
                background: var(--color-aqua);
                bottom: -80px;
                right: -80px;
                animation-delay: 2s;
            }

            .dashboard-wrapper {
                display: flex;
                min-height: 100vh;
                padding: 1.5rem;
                gap: 1.5rem;
                position: relative;
                z-index: 1;
            }

            /* ── Sidebar ──────────────────────────────────────────────── */
            .sidebar {
                width: 260px;
                background: var(--color-blanco-glass);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                border-radius: 24px;
                padding: 2rem 1.5rem;
                display: flex;
                flex-direction: column;
                box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15), 0 0 0 2px rgba(255, 255, 255, 0.6);
                flex-shrink: 0;
            }

            .sidebar-logo {
                color: var(--color-verde);
                font-size: 1.8rem;
                font-weight: 800;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                margin-bottom: 2.5rem;
                padding-left: 0.5rem;
            }

                .sidebar-logo i {
                    color: var(--color-aqua);
                    font-size: 2rem;
                }

            .nav-menu {
                list-style: none;
                padding: 0;
                margin: 0;
                flex-grow: 1;
            }

            .nav-item {
                margin-bottom: 0.75rem;
            }

            .nav-link {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.85rem 1.25rem;
                border-radius: 16px;
                color: var(--color-texto);
                font-weight: 700;
                font-size: 0.95rem;
                text-decoration: none;
                transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
                border: 2px solid transparent;
            }

                .nav-link i {
                    font-size: 1.2rem;
                    transition: transform 0.3s ease;
                }

                .nav-link:hover {
                    background-color: var(--color-amarillo);
                    color: var(--color-verde);
                    transform: translateX(5px);
                }

                    .nav-link:hover i {
                        transform: scale(1.1);
                    }

                .nav-link.active {
                    background: linear-gradient(135deg, var(--color-verde) 0%, var(--color-aqua) 100%);
                    color: white;
                    box-shadow: 0 4px 15px rgba(154, 191, 23, 0.3);
                }

                    .nav-link.active i {
                        color: white;
                    }

            .sidebar-footer {
                margin-top: auto;
                padding-top: 1.5rem;
                border-top: 2px solid var(--color-azul-claro);
            }

            .btn-logout {
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 0.5rem;
                width: 100%;
                padding: 0.75rem;
                border-radius: 16px;
                border: 2px solid #fecaca;
                background-color: #fef2f2;
                color: #e11d48;
                font-weight: 700;
                text-decoration: none;
                transition: all 0.3s ease;
            }

                .btn-logout:hover {
                    background-color: #e11d48;
                    color: white;
                    border-color: #e11d48;
                }

            .main-content {
                flex-grow: 1;
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
            }

            .top-bar {
                background: var(--color-blanco-glass);
                backdrop-filter: blur(12px);
                border-radius: 24px;
                padding: 1.25rem 2rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15), 0 0 0 2px rgba(255, 255, 255, 0.6);
            }

            .welcome-text h2 {
                margin: 0;
                font-size: 1.5rem;
                font-weight: 800;
                color: var(--color-texto);
            }

            .welcome-text p {
                margin: 0;
                font-size: 0.9rem;
                color: var(--color-texto-claro);
                font-weight: 600;
            }

            .btn-volver {
                display: inline-flex;
                align-items: center;
                gap: 0.4rem;
                background: white;
                border-radius: 50px;
                padding: 0.5rem 1.1rem;
                color: var(--color-verde);
                font-weight: 700;
                font-size: 0.85rem;
                text-decoration: none;
                box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            }

                .btn-volver:hover {
                    color: var(--color-verde);
                    transform: translateY(-2px);
                }

            .content-card {
                background: var(--color-blanco-glass);
                backdrop-filter: blur(12px);
                border-radius: 24px;
                padding: 2rem;
                box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15), 0 0 0 2px rgba(255, 255, 255, 0.6);
            }

            .empty-state {
                text-align: center;
                padding: 2rem 1rem;
                color: var(--color-texto-claro);
                font-weight: 600;
                font-size: 0.9rem;
            }

                .empty-state i {
                    font-size: 1.8rem;
                    display: block;
                    margin-bottom: 0.5rem;
                    color: var(--color-aqua);
                }

            .card-header-custom {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 1.5rem;
            }

                .card-header-custom h3 {
                    margin: 0;
                    font-size: 1.15rem;
                    font-weight: 800;
                    color: var(--color-verde);
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

            .table-cute {
                width: 100%;
                border-collapse: separate;
                border-spacing: 0 0.6rem;
            }

                .table-cute thead th {
                    background-color: var(--color-azul-claro);
                    color: var(--color-texto);
                    font-weight: 700;
                    font-size: 0.78rem;
                    text-transform: uppercase;
                    letter-spacing: 0.05em;
                    padding: 0.75rem 1rem;
                    border: none;
                }

                    .table-cute thead th:first-child {
                        border-radius: 12px 0 0 12px;
                    }

                    .table-cute thead th:last-child {
                        border-radius: 0 12px 12px 0;
                    }

                .table-cute tbody tr {
                    background-color: white;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
                    transition: all 0.2s ease;
                }

                    .table-cute tbody tr:hover {
                        transform: scale(1.01);
                        box-shadow: 0 4px 12px rgba(132, 191, 147, 0.2);
                    }

                .table-cute tbody td {
                    padding: 0.85rem 1rem;
                    vertical-align: middle;
                    border: none;
                    font-size: 0.88rem;
                    color: var(--color-texto);
                }

                    .table-cute tbody td:first-child {
                        border-radius: 12px 0 0 12px;
                    }

                    .table-cute tbody td:last-child {
                        border-radius: 0 12px 12px 0;
                    }

            .badge-cute {
                padding: 0.3rem 0.7rem;
                border-radius: 50px;
                font-size: 0.72rem;
                font-weight: 700;
                white-space: nowrap;
            }

            .badge-proceso {
                background-color: var(--color-amarillo);
                color: #857a10;
            }

            .progreso-wrap {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                min-width: 120px;
            }

            .progreso-bar {
                flex-grow: 1;
                height: 8px;
                border-radius: 50px;
                background-color: var(--color-azul-claro);
                overflow: hidden;
            }

            .progreso-fill {
                height: 100%;
                border-radius: 50px;
                transition: width 0.4s ease, background 0.4s ease;
            }

                .progreso-fill.baja {
                    background: linear-gradient(135deg, #f87171, var(--color-rojo));
                }

                .progreso-fill.media {
                    background: linear-gradient(135deg, #f3d774, #e8b830);
                }

                .progreso-fill.alta {
                    background: linear-gradient(135deg, var(--color-verde), var(--color-aqua));
                }

            .progreso-label {
                font-size: 0.78rem;
                font-weight: 800;
                min-width: 32px;
                text-align: right;
            }

                .progreso-label.baja {
                    color: var(--color-rojo);
                }

                .progreso-label.media {
                    color: #b8860b;
                }

                .progreso-label.alta {
                    color: var(--color-verde);
                }

            @@media (max-width: 768px) {
                .dashboard-wrapper {
                    flex-direction: column;
                    padding: 1rem;
                }

                .sidebar {
                    width: 100%;
                    padding: 1.5rem;
                }

                .nav-link {
                    padding: 0.75rem 1rem;
                }
            }
    </style>
</head>
<body>
    <div class="bg-blob blob-1"></div>
    <div class="bg-blob blob-2"></div>

    <div class="dashboard-wrapper">
        @await Html.PartialAsync("_Sidebar")

        <main class="main-content">
            <div class="top-bar">
                <div class="welcome-text">
                    <h2><i class="bi bi-gear-fill"></i> Monitoreo de producción</h2>
                    <p>Estado en tiempo real de las líneas de producción.</p>
                </div>
                <a class="btn-volver" asp-controller="Monitoreo" asp-action="Index">
                    <i class="bi bi-arrow-left"></i> Volver al menú
                </a>
                <!-- Este link ya está bien: sigue apuntando a MonitoreoController/Index (el menú) -->
                <!-- La vista misma ahora vive en Views/MonitoreoProduccion/Index.cshtml -->
                <!-- porque pertenece a MonitoreoProduccionController -->

            </div>

            <div class="content-card">
                <div class="card-header-custom">
                    <h3><i class="bi bi-list-check"></i> Proceso de orden</h3>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table-cute">
                            <thead>
                                <tr>
                                    <th>N° Orden</th>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Tiempo de producción</th>
                                    <th>Estado</th>
                                    <th>Progreso</th>
                                    <th>Línea</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var o in Model)
                                {
                                    string colorClase = o.PorcentajeAvance >= 75 ? "alta"
                                        : o.PorcentajeAvance >= 40 ? "media"
                                        : "baja";
                                    <tr>
                                        <td><strong>@o.NumeroOrden</strong></td>
                                        <td>@o.Producto</td>
                                        <td>@o.Cantidad</td>
                                        <td>@o.TiempoProduccion</td>
                                        <td><span class="badge-cute badge-proceso">@o.EstadoProduccion</span></td>
                                        <td>
                                            <div class="progreso-wrap">
                                                <div class="progreso-bar">
                                                    <div class="progreso-fill @colorClase" style="width:@o.PorcentajeAvance%;"></div>
                                                </div>
                                                <span class="progreso-label @colorClase">@o.PorcentajeAvance%</span>
                                            </div>
                                        </td>
                                        <td>@o.LineaProduccion</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-check-circle"></i>
                        No hay órdenes en producción actualmente.
                    </div>
                }
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
</body>
</html>