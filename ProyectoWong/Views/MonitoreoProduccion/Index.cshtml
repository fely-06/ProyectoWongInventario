@{
    Layout = null;
    ViewBag.Title = "Monitoreo de Producción - SIV";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
            :root {
                --color-amarillo: #f3eeb6;
                --color-verde-claro: #d4db74;
                --color-verde: #9abf17;
                --color-aqua: #84bf93;
                --color-aqua-claro: #aed9c5;
                --color-azul-claro: #ddecf1;
                --color-texto: #4a5568;
                --color-texto-claro: #718096;
                --color-blanco-glass: rgba(255, 255, 255, 0.85);
                --color-rojo: #ef4444;
            }

            body {
                font-family: 'Nunito', sans-serif;
                background: linear-gradient(135deg, var(--color-azul-claro) 0%, var(--color-amarillo) 50%, var(--color-aqua-claro) 100%);
                min-height: 100vh;
                margin: 0;
                color: var(--color-texto);
            }

            .dashboard-wrapper {
                display: flex;
                min-height: 100vh;
                padding: 1.5rem;
                gap: 1.5rem;
            }

            .sidebar {
                width: 260px;
                background: var(--color-blanco-glass);
                backdrop-filter: blur(12px);
                border-radius: 24px;
                padding: 2rem 1.5rem;
                display: flex;
                flex-direction: column;
                box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15);
                flex-shrink: 0;
            }

            .main-content {
                flex-grow: 1;
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
            }

            .top-bar {
                background: var(--color-blanco-glass);
                backdrop-filter: blur(12px);
                border-radius: 24px;
                padding: 1.25rem 2rem;
                display: flex;
                justify-content: space-between;
                align-items: center;
                box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15);
            }

            .content-card {
                background: var(--color-blanco-glass);
                backdrop-filter: blur(12px);
                border-radius: 24px;
                padding: 2rem;
                box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15);
            }

            .filtros-wrap {
                display: flex;
                gap: 0.5rem;
                margin-bottom: 1.5rem;
                flex-wrap: wrap;
            }

            .btn-filtro {
                background: white;
                border: 2px solid var(--color-azul-claro);
                border-radius: 50px;
                padding: 0.5rem 1.2rem;
                color: var(--color-texto);
                font-weight: 700;
                font-size: 0.85rem;
                cursor: pointer;
                transition: all 0.3s ease;
            }

                .btn-filtro:hover {
                    border-color: var(--color-aqua);
                    color: var(--color-verde);
                }

                .btn-filtro.active {
                    background: linear-gradient(135deg, var(--color-verde) 0%, var(--color-aqua) 100%);
                    color: white;
                    border-color: transparent;
                }
                /* Agrega esto en el <style> de MonitoreoProduccion/Index.cshtml */
                .sidebar {
                    width: 260px;
                    background: var(--color-blanco-glass);
                    backdrop-filter: blur(12px);
                    border-radius: 24px;
                    padding: 2rem 1.5rem;
                    display: flex;
                    flex-direction: column;
                    box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15);
                    flex-shrink: 0;
                }

                .sidebar-logo {
                    color: var(--color-verde);
                    font-size: 1.8rem;
                    font-weight: 800;
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    margin-bottom: 2.5rem;
                }

                .nav-menu {
                    list-style: none;
                    padding: 0;
                    margin: 0;
                    flex-grow: 1;
                }

                .nav-link {
                    display: flex;
                    align-items: center;
                    gap: 0.75rem;
                    padding: 0.85rem 1.25rem;
                    border-radius: 16px;
                    color: var(--color-texto);
                    font-weight: 700;
                    text-decoration: none;
                    transition: all 0.3s;
                    border: 2px solid transparent;
                    margin-bottom: 0.75rem;
                }

                .nav-link:hover {
                    background-color: var(--color-amarillo);
                    color: var(--color-verde);
                }

                .nav-link.active {
                    background: linear-gradient(135deg, var(--color-verde) 0%, var(--color-aqua) 100%);
                    color: white;
                }
            .table-cute {
                width: 100%;
                border-collapse: separate;
                border-spacing: 0 0.6rem;
            }

                .table-cute thead th {
                    background-color: var(--color-azul-claro);
                    color: var(--color-texto);
                    font-weight: 700;
                    font-size: 0.78rem;
                    text-transform: uppercase;
                    padding: 0.75rem 1rem;
                    border: none;
                }

                    .table-cute thead th:first-child {
                        border-radius: 12px 0 0 12px;
                    }

                    .table-cute thead th:last-child {
                        border-radius: 0 12px 12px 0;
                    }

                .table-cute tbody tr {
                    background-color: white;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
                    transition: all 0.2s ease;
                }

                    .table-cute tbody tr:hover {
                        transform: scale(1.01);
                        box-shadow: 0 4px 12px rgba(132, 191, 147, 0.2);
                    }

                .table-cute tbody td {
                    padding: 0.85rem 1rem;
                    vertical-align: middle;
                    border: none;
                    font-size: 0.88rem;
                }

                    .table-cute tbody td:first-child {
                        border-radius: 12px 0 0 12px;
                    }

                    .table-cute tbody td:last-child {
                        border-radius: 0 12px 12px 0;
                    }

            .badge-cute {
                padding: 0.3rem 0.7rem;
                border-radius: 50px;
                font-size: 0.72rem;
                font-weight: 700;
                white-space: nowrap;
            }

            .badge-cute-warning {
                background-color: #fef3c7;
                color: #92400e;
            }

            .badge-cute-info {
                background-color: var(--color-azul-claro);
                color: #1e5a73;
            }

            .badge-cute-success {
                background-color: var(--color-verde-claro);
                color: #3f4d12;
            }

            .progreso-wrap {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                min-width: 140px;
            }

            .progreso-bar {
                flex-grow: 1;
                height: 10px;
                border-radius: 50px;
                background-color: var(--color-azul-claro);
                overflow: hidden;
            }

            .progreso-fill {
                height: 100%;
                border-radius: 50px;
                transition: width 0.5s ease, background 0.5s ease;
            }

                .progreso-fill.baja {
                    background: linear-gradient(135deg, #f87171, var(--color-rojo));
                }

                .progreso-fill.media {
                    background: linear-gradient(135deg, #f3d774, #e8b830);
                }

                .progreso-fill.alta {
                    background: linear-gradient(135deg, var(--color-verde), var(--color-aqua));
                }

            .progreso-label {
                font-size: 0.78rem;
                font-weight: 800;
                min-width: 35px;
                text-align: right;
            }

                .progreso-label.baja {
                    color: var(--color-rojo);
                }

                .progreso-label.media {
                    color: #b8860b;
                }

                .progreso-label.alta {
                    color: var(--color-verde);
                }
    </style>
</head>
<body>
    <div class="dashboard-wrapper">
        @await Html.PartialAsync("_Sidebar")

        <main class="main-content">
            <div class="top-bar">
                <div>
                    <h2 style="margin:0; font-weight:800; color:var(--color-verde);"><i class="bi bi-activity"></i> Monitoreo de Producción</h2>
                    <p style="margin:0; font-size:0.9rem; color:var(--color-texto-claro);">Estado en tiempo real de las órdenes de fabricación.</p>
                </div>
                <a class="btn btn-light rounded-pill fw-bold" asp-controller="Produccion" asp-action="Index">
                    <i class="bi bi-arrow-left"></i> Ir a Ordenes de Producción
                </a>
            </div>

            <div class="content-card">
                <!-- BOTONES DE FILTRO -->
                <div class="filtros-wrap">
                    <button class="btn-filtro" data-filtro="Todas">Todas</button>
                    <button class="btn-filtro" data-filtro="Pendiente">Pendientes</button>
                    <button class="btn-filtro active" data-filtro="EnProceso">En Proceso</button>
                    <button class="btn-filtro" data-filtro="Pausada">Pausadas</button>
                    <button class="btn-filtro" data-filtro="Completada">Completadas</button>
                </div>

                <div class="table-responsive">
                    <table class="table-cute">
                        <thead>
                            <tr>
                                <th>N° Orden</th>
                                <th>Producto</th>
                                <th class="text-center">Cantidad</th>
                                <th>Tiempo (Real / Total)</th>
                                <th>Estado</th>
                                <th>Progreso</th>
                                <th>Línea</th>
                            </tr>
                        </thead>
                        <tbody id="tablaMonitoreoBody">
                            <tr><td colspan="7" class="text-center text-muted py-4">Cargando datos en tiempo real...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script>
            let filtroActual = 'En Proceso';
            let intervaloMonitoreo = null;

            $(function() {
                console.log(" Inicializando Monitoreo de Producción...");

                // Manejo de clic en filtros
                $('.btn-filtro').on('click', function() {
                    $('.btn-filtro').removeClass('active');
                    $(this).addClass('active');
                    filtroActual = $(this).data('filtro');
                    console.log("🔄 Filtro cambiado a:", filtroActual);
                    cargarDatos();
                });

                // Carga inicial
                cargarDatos();

                // Actualización automática cada 5 segundos
                intervaloMonitoreo = setInterval(cargarDatos, 5000);
            });

            function cargarDatos() {
                console.log("📡 Consultando datos con filtro:", filtroActual);

                $.ajax({
                    url: '/ObtenerDatosMonitoreo',
                    type: 'GET',
                    data: { filtro: filtroActual },
                    success: function(r) {

                        if (r.success && r.data) {
                            renderizarTabla(r.data);
                        } else {
                            console.error("Respuesta completa:", r);
                            $('#tablaMonitoreoBody').html(
                                '<tr><td colspan="7" class="text-center text-danger py-4">Error: No se recibieron datos válidos del servidor</td></tr>'
                            );
                        }
                    },
                    error: function(xhr, status, error) {
                        console.error("❌ Error en la petición AJAX:", error);
                        console.error("Status:", status);
                        console.error("XHR:", xhr);
                        $('#tablaMonitoreoBody').html(
                            `<tr><td colspan="7" class="text-center text-danger py-4">Error de conexión: ${error}</td></tr>`
                        );
                    }
                });
            }

            function renderizarTabla(datos) {
                const tbody = $('#tablaMonitoreoBody');

                if (!datos || datos.length === 0) {
                    tbody.html('<tr><td colspan="7" class="text-center text-muted py-4">No hay órdenes con este filtro.</td></tr>');
                    return;
                }

                let html = '';
                $.each(datos, function(i, o) {
                    // Debug: mostrar el primer objeto en consola
                    if (i === 0) {
                        console.log(" Primer objeto a renderizar:", o);
                    }

                    // Validar que las propiedades existan
                    let numeroOrden = o.NumeroOrden || o.numeroOrden || 'N/A';
                    let producto = o.Producto || o.producto || 'Sin producto';
                    let cantidad = o.Cantidad || o.cantidad || 0;
                    let tiempo = o.TiempoProduccion || o.tiempoProduccion || '00:00 / 00:00';
                    let estado = o.Estado || o.estado || 'Desconocido';
                    let porcentaje = o.PorcentajeAvance || o.porcentajeAvance || 0;
                    let linea = o.LineaProduccion || o.lineaProduccion || 'N/A';

                    let colorClase = porcentaje >= 75 ? "alta" : porcentaje >= 40 ? "media" : "baja";

                    let badgeClass = 'badge-cute-warning';
                    if (estado === 'EnProceso' || estado === 'enproceso') badgeClass = 'badge-cute-info';
                    else if (estado === 'Completada' || estado === 'completada') badgeClass = 'badge-cute-success';
                    else if (estado === 'Pausada' || estado === 'pausada') badgeClass = 'badge-cute-warning';

                    html += `
                            <tr>
                                <td><strong>${numeroOrden}</strong></td>
                                <td>${producto}</td>
                                <td class="text-center">${cantidad} uds</td>
                                <td style="font-family: monospace; font-weight:600;">${tiempo}</td>
                                <td><span class="badge-cute ${badgeClass}">${estado}</span></td>
                                <td>
                                    <div class="progreso-wrap">
                                        <div class="progreso-bar">
                                            <div class="progreso-fill ${colorClase}" style="width: ${porcentaje}%"></div>
                                        </div>
                                        <span class="progreso-label ${colorClase}">${porcentaje}%</span>
                                    </div>
                                </td>
                                <td>${linea}</td>
                            </tr>
                        `;
                });

                tbody.html(html);
            }
    </script>
</body>
</html>