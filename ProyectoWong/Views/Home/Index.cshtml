@model ProyectoWong.Models.DashboardViewModel

@{
    Layout = null;
    ViewBag.Title = "Dashboard - SIV";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>

    <!-- Fuente redondeada y amigable -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <style>
        :root {
            --color-amarillo: #f3eeb6;
            --color-verde-claro: #d4db74;
            --color-verde: #9abf17;
            --color-aqua: #84bf93;
            --color-aqua-claro: #aed9c5;
            --color-azul-claro: #ddecf1;
            --color-texto: #4a5568;
            --color-texto-claro: #718096;
            --color-blanco-glass: rgba(255, 255, 255, 0.85);
            --color-rojo: #e11d48;
            --color-rojo-claro: #fee2e2;
        }

        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(135deg, var(--color-azul-claro) 0%, var(--color-amarillo) 50%, var(--color-aqua-claro) 100%);
            min-height: 100vh;
            margin: 0;
            position: relative;
            overflow-x: hidden;
            color: var(--color-texto);
        }

/* IMPORTANTE: @@keyframes y @@media deben estar al inicio absoluto de la línea sin espacios */
@@keyframes float {
    0%, 100% { transform: translateY(0px) scale(1); }
    50% { transform: translateY(-20px) scale(1.05); }
}

        .bg-blob {
            position: fixed;
            border-radius: 50%;
            filter: blur(60px);
            z-index: 0;
            opacity: 0.6;
            animation: float 8s ease-in-out infinite;
        }
        .blob-1 { width: 400px; height: 400px; background: var(--color-verde-claro); top: -100px; left: -100px; }
        .blob-2 { width: 350px; height: 350px; background: var(--color-aqua); bottom: -80px; right: -80px; animation-delay: 2s; }
        .blob-3 { width: 250px; height: 250px; background: var(--color-amarillo); top: 30%; right: 20%; animation-delay: 4s; }

        .dashboard-wrapper {
            display: flex;
            min-height: 100vh;
            padding: 1.5rem;
            gap: 1.5rem;
            position: relative;
            z-index: 1;
        }

        .sidebar {
            width: 260px;
            background: var(--color-blanco-glass);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 24px;
            padding: 2rem 1.5rem;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15), 0 0 0 2px rgba(255, 255, 255, 0.6);
            flex-shrink: 0;
        }

        .sidebar-logo {
            color: var(--color-verde);
            font-size: 1.8rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 2.5rem;
            padding-left: 0.5rem;
        }
        .sidebar-logo i { color: var(--color-aqua); font-size: 2rem; }

        .nav-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            flex-grow: 1;
        }

        .nav-item { margin-bottom: 0.75rem; }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.85rem 1.25rem;
            border-radius: 16px;
            color: var(--color-texto);
            font-weight: 700;
            font-size: 0.95rem;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            border: 2px solid transparent;
        }

        .nav-link i { font-size: 1.2rem; transition: transform 0.3s ease; }

        .nav-link:hover {
            background-color: var(--color-amarillo);
            color: var(--color-verde);
            transform: translateX(5px);
        }
        .nav-link:hover i { transform: scale(1.1); }

        .nav-link.active {
            background: linear-gradient(135deg, var(--color-verde) 0%, var(--color-aqua) 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(154, 191, 23, 0.3);
        }
        .nav-link.active i { color: white; }

        .sidebar-footer {
            margin-top: auto;
            padding-top: 1.5rem;
            border-top: 2px solid var(--color-azul-claro);
        }

        .btn-logout {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            width: 100%;
            padding: 0.75rem;
            border-radius: 16px;
            border: 2px solid #fecaca;
            background-color: #fef2f2;
            color: #e11d48;
            font-weight: 700;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        .btn-logout:hover {
            background-color: #e11d48;
            color: white;
            border-color: #e11d48;
        }

        .main-content {
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
        }

        .top-bar {
            background: var(--color-blanco-glass);
            backdrop-filter: blur(12px);
            border-radius: 24px;
            padding: 1.25rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15), 0 0 0 2px rgba(255, 255, 255, 0.6);
        }

        .welcome-text h2 {
            margin: 0;
            font-size: 1.5rem;
            font-weight: 800;
            color: var(--color-texto);
        }
        .welcome-text p {
            margin: 0;
            font-size: 0.9rem;
            color: var(--color-texto-claro);
            font-weight: 600;
        }

        .user-profile {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        .user-avatar {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: linear-gradient(135deg, var(--color-amarillo), var(--color-verde-claro));
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            color: var(--color-verde);
            font-size: 1.2rem;
            border: 2px solid white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }

        /* ── KPI cards ─────────────────────────────────────────────── */
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
            gap: 1.25rem;
        }
        .kpi-card {
            background: var(--color-blanco-glass);
            backdrop-filter: blur(12px);
            border-radius: 20px;
            padding: 1.4rem 1.5rem;
            box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15), 0 0 0 2px rgba(255, 255, 255, 0.6);
            display: flex;
            align-items: center;
            gap: 1rem;
            animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .kpi-icon {
            width: 52px;
            height: 52px;
            min-width: 52px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            color: white;
        }
        .kpi-icon.verde { background: linear-gradient(135deg, var(--color-verde), var(--color-aqua)); }
        .kpi-icon.rojo { background: linear-gradient(135deg, #f87171, var(--color-rojo)); }
        .kpi-icon.amarillo { background: linear-gradient(135deg, #f3d774, #e8b830); }
        .kpi-icon.azul { background: linear-gradient(135deg, #7dd3fc, #38bdf8); }

        .kpi-value {
            font-size: 1.6rem;
            font-weight: 800;
            line-height: 1;
            color: var(--color-texto);
        }
        .kpi-label {
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--color-texto-claro);
            text-transform: uppercase;
            letter-spacing: 0.03em;
            margin-top: 0.25rem;
        }

        .panels-grid {
            display: grid;
            grid-template-columns: 1.3fr 1fr;
            gap: 1.5rem;
            align-items: start;
        }

        .content-card {
            background: var(--color-blanco-glass);
            backdrop-filter: blur(12px);
            border-radius: 24px;
            padding: 2rem;
            box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15), 0 0 0 2px rgba(255, 255, 255, 0.6);
            animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        }

@@keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

        .card-header-custom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }
        .card-header-custom h3 {
            margin: 0;
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--color-verde);
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .btn-cute-primary {
            background: linear-gradient(135deg, var(--color-verde) 0%, var(--color-aqua) 100%);
            border: none;
            border-radius: 50px;
            padding: 0.5rem 1.1rem;
            color: white;
            font-weight: 700;
            font-size: 0.85rem;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            text-decoration: none;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(154, 191, 23, 0.3);
        }
        .btn-cute-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(154, 191, 23, 0.4);
            color: white;
        }

        .table-cute {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 0.6rem;
        }
        .table-cute thead th {
            background-color: var(--color-azul-claro);
            color: var(--color-texto);
            font-weight: 700;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 0.75rem 1rem;
            border: none;
        }
        .table-cute thead th:first-child { border-radius: 12px 0 0 12px; }
        .table-cute thead th:last-child { border-radius: 0 12px 12px 0; }

        .table-cute tbody tr {
            background-color: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
            transition: all 0.2s ease;
        }
        .table-cute tbody tr:hover {
            transform: scale(1.01);
            box-shadow: 0 4px 12px rgba(132, 191, 147, 0.2);
        }
        .table-cute tbody td {
            padding: 0.85rem 1rem;
            vertical-align: middle;
            border: none;
            font-size: 0.88rem;
            color: var(--color-texto);
        }
        .table-cute tbody td:first-child { border-radius: 12px 0 0 12px; }
        .table-cute tbody td:last-child { border-radius: 0 12px 12px 0; }

        .badge-cute {
            padding: 0.3rem 0.7rem;
            border-radius: 50px;
            font-size: 0.72rem;
            font-weight: 700;
            white-space: nowrap;
        }
        .badge-critico { background-color: var(--color-rojo-claro); color: #991b1b; }
        .badge-proceso { background-color: var(--color-amarillo); color: #857a10; }
        .badge-ok { background-color: #dcfce7; color: #15803d; }

        .empty-state {
            text-align: center;
            padding: 2rem 1rem;
            color: var(--color-texto-claro);
            font-weight: 600;
            font-size: 0.9rem;
        }
        .empty-state i { font-size: 1.8rem; display: block; margin-bottom: 0.5rem; color: var(--color-aqua); }

        .quick-links {
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
        }
        .quick-link {
            flex: 1 1 130px;
            background: white;
            border-radius: 16px;
            padding: 1rem;
            text-decoration: none;
            color: var(--color-texto);
            font-weight: 700;
            font-size: 0.85rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
            transition: all 0.2s ease;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            align-items: flex-start;
        }
        .quick-link i { font-size: 1.3rem; color: var(--color-verde); }
        .quick-link:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(132, 191, 147, 0.25);
            color: var(--color-verde);
        }

@@media (max-width: 992px) {
    .panels-grid { grid-template-columns: 1fr; }
}
@@media (max-width: 768px) {
    .dashboard-wrapper { flex-direction: column; padding: 1rem; }
    .sidebar { width: 100%; padding: 1.5rem; }
    .nav-link { padding: 0.75rem 1rem; }
}
    </style>
</head>
<body>
    <div class="bg-blob blob-1"></div>
    <div class="bg-blob blob-2"></div>
    <div class="bg-blob blob-3"></div>

    <div class="dashboard-wrapper">
        @await Html.PartialAsync("_Sidebar")

        <main class="main-content">
            <div class="top-bar">
                <div class="welcome-text">
                    <h2>¡Hola! 👋</h2>
                    <p>Aquí tienes un resumen del sistema hoy, @DateTime.Now.ToString("dddd d 'de' MMMM", new System.Globalization.CultureInfo("es-ES")).</p>
                </div>
                <div class="user-profile">
                    <div style="text-align: right;">
                        <div style="font-weight: 700; font-size: 0.95rem;">Admin SIV</div>
                        <div style="font-size: 0.8rem; color: var(--color-texto-claro);">admin@siv.com</div>
                    </div>
                    <div class="user-avatar">A</div>
                </div>
            </div>

            <!-- ── KPIs ────────────────────────────────────────────── -->
            <div class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-icon verde"><i class="bi bi-cpu-fill"></i></div>
                    <div>
                        <div class="kpi-value">@Model.TotalComponentes</div>
                        <div class="kpi-label">Componentes activos</div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-icon rojo"><i class="bi bi-exclamation-triangle-fill"></i></div>
                    <div>
                        <div class="kpi-value">@Model.ComponentesBajoMinimo</div>
                        <div class="kpi-label">Bajo mínimo</div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-icon amarillo"><i class="bi bi-file-earmark-text-fill"></i></div>
                    <div>
                        <div class="kpi-value">@Model.OrdenesCompraAbiertas</div>
                        <div class="kpi-label">OC abiertas</div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-icon azul"><i class="bi bi-box-seam-fill"></i></div>
                    <div>
                        <div class="kpi-value">@Model.RecepcionesEnProceso</div>
                        <div class="kpi-label">Recepciones en proceso</div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-icon rojo"><i class="bi bi-pin-map-fill"></i></div>
                    <div>
                        <div class="kpi-value">@Model.PalletsSinUbicacion</div>
                        <div class="kpi-label">Pallets sin ubicación</div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-icon verde"><i class="bi bi-geo-alt-fill"></i></div>
                    <div>
                        <div class="kpi-value">@Model.UbicacionesActivas</div>
                        <div class="kpi-label">Ubicaciones activas</div>
                    </div>
                </div>
            </div>

            <div class="panels-grid">
                <!-- ── Últimos movimientos ─────────────────────────── -->
                <div class="content-card">
                    <div class="card-header-custom">
                        <h3><i class="bi bi-clock-history"></i> Últimos movimientos de inventario</h3>
                        <a asp-controller="Inventario" asp-action="Index" class="btn-cute-primary">
                            Ver inventario <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>

                    @if (Model.UltimosMovimientos.Any())
                    {
                        <div class="table-responsive">
                            <table class="table-cute">
                                <thead>
                                    <tr>
                                        <th>Pallet</th>
                                        <th>Componente</th>
                                        <th>Ubicación</th>
                                        <th>Fecha</th>
                                        <th>Por</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in Model.UltimosMovimientos)
                                    {
                                        <tr>
                                            <td><strong>@m.CodigoPallet</strong></td>
                                            <td>@(m.Componente ?? "-")</td>
                                            <td>@(m.Ubicacion ?? "-")</td>
                                            <td>@m.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@(m.RealizadoPor ?? "-")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="bi bi-inbox"></i>
                            Todavía no hay movimientos de inventario registrados.
                        </div>
                    }
                </div>

                <!-- ── Columna lateral ──────────────────────────────── -->
                <div style="display:flex; flex-direction:column; gap:1.5rem;">
                    <div class="content-card">
                        <div class="card-header-custom">
                            <h3><i class="bi bi-exclamation-triangle-fill"></i> Stock crítico</h3>
                            <a asp-controller="Componente" asp-action="Index" class="btn-cute-primary">
                                Ver <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>

                        @if (Model.ComponentesCriticos.Any())
                        {
                            <div class="table-responsive">
                                <table class="table-cute">
                                    <thead>
                                        <tr>
                                            <th>Pieza</th>
                                            <th>Stock</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var c in Model.ComponentesCriticos)
                                        {
                                            <tr>
                                                <td>
                                                    <strong>@c.NumeroPieza</strong><br />
                                                    <span style="font-size:0.78rem; color: var(--color-texto-claro);">@c.Nombre</span>
                                                </td>
                                                <td>@c.Cantidad / @c.MinimoInventario</td>
                                                <td><span class="badge-cute badge-critico">Crítico</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="bi bi-check-circle"></i>
                                Todo el inventario está por encima del mínimo.
                            </div>
                        }
                    </div>

                    <div class="content-card">
                        <div class="card-header-custom">
                            <h3><i class="bi bi-truck"></i> Accesos rápidos</h3>
                        </div>
                        <div class="quick-links">
                            <a class="quick-link" asp-controller="Recepcion" asp-action="Index">
                                <i class="bi bi-box-seam-fill"></i> Recepción
                            </a>
                            <a class="quick-link" asp-controller="Ordenescompra" asp-action="Index">
                                <i class="bi bi-file-earmark-text-fill"></i> Órdenes de compra
                            </a>
                            <a class="quick-link" asp-controller="Componente" asp-action="Index">
                                <i class="bi bi-cpu-fill"></i> Componentes
                            </a>
                            <a class="quick-link" asp-controller="Inventario" asp-action="Index">
                                <i class="bi bi-boxes"></i> Inventario
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Recepciones pendientes ───────────────────────────── -->
            <div class="content-card">
                <div class="card-header-custom">
                    <h3><i class="bi bi-hourglass-split"></i> Recepciones en proceso</h3>
                    <a asp-controller="Recepcion" asp-action="Index" class="btn-cute-primary">
                        Ir a Recepción <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                @if (Model.RecepcionesPendientes.Any())
                {
                    <div class="table-responsive">
                        <table class="table-cute">
                            <thead>
                                <tr>
                                    <th>Orden de compra</th>
                                    <th>Lotes</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.RecepcionesPendientes)
                                {
                                    <tr>
                                        <td><strong>@r.NumeroOC</strong></td>
                                        <td>@r.CantidadLotes</td>
                                        <td>@r.FechaRecepcion.ToString("dd/MM/yyyy")</td>
                                        <td><span class="badge-cute badge-proceso">@r.Estado</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-check-circle"></i>
                        No hay recepciones pendientes por procesar.
                    </div>
                }
            </div>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
</body>
</html>
