@{
    Layout = null;
    ViewBag.Title = "Producción - SIV";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
            :root {
                --color-amarillo: #f3eeb6;
                --color-verde-claro: #d4db74;
                --color-verde: #9abf17;
                --color-aqua: #84bf93;
                --color-aqua-claro: #aed9c5;
                --color-azul-claro: #ddecf1;
                --color-texto: #4a5568;
                --color-texto-claro: #718096;
                --color-blanco-glass: rgba(255, 255, 255, 0.85);
            }

            body {
                font-family: 'Nunito', sans-serif;
                background: linear-gradient(135deg, var(--color-azul-claro) 0%, var(--color-amarillo) 50%, var(--color-aqua-claro) 100%);
                min-height: 100vh;
                margin: 0;
                color: var(--color-texto);
            }

            .dashboard-wrapper {
                display: flex;
                min-height: 100vh;
                padding: 1.5rem;
                gap: 1.5rem;
            }

            .sidebar {
                width: 260px;
                background: var(--color-blanco-glass);
                backdrop-filter: blur(12px);
                border-radius: 24px;
                padding: 2rem 1.5rem;
                display: flex;
                flex-direction: column;
                box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15);
                flex-shrink: 0;
            }

            .sidebar-logo {
                color: var(--color-verde);
                font-size: 1.8rem;
                font-weight: 800;
                display: flex;
                align-items: center;
                gap: 0.5rem;
                margin-bottom: 2.5rem;
            }

            .nav-menu {
                list-style: none;
                padding: 0;
                margin: 0;
                flex-grow: 1;
            }

            .nav-link {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                padding: 0.85rem 1.25rem;
                border-radius: 16px;
                color: var(--color-texto);
                font-weight: 700;
                text-decoration: none;
                transition: all 0.3s;
                border: 2px solid transparent;
                margin-bottom: 0.75rem;
            }

                .nav-link:hover {
                    background-color: var(--color-amarillo);
                    color: var(--color-verde);
                }

                .nav-link.active {
                    background: linear-gradient(135deg, var(--color-verde) 0%, var(--color-aqua) 100%);
                    color: white;
                }

            .main-content {
                flex-grow: 1;
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
            }

            .content-card {
                background: var(--color-blanco-glass);
                backdrop-filter: blur(12px);
                border-radius: 24px;
                padding: 2rem;
                box-shadow: 0 10px 30px rgba(132, 191, 147, 0.15);
            }

            .card-header-custom {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 1.5rem;
            }

                .card-header-custom h3 {
                    margin: 0;
                    font-size: 1.3rem;
                    font-weight: 800;
                    color: var(--color-verde);
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

            .btn-cute-primary {
                background: linear-gradient(135deg, var(--color-verde) 0%, var(--color-aqua) 100%);
                border: none;
                border-radius: 50px;
                padding: 0.6rem 1.25rem;
                color: white;
                font-weight: 700;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
            }

                .btn-cute-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(154, 191, 23, 0.4);
                    color: white;
                }

            .btn-cute-secondary {
                background: var(--color-azul-claro);
                border: none;
                border-radius: 50px;
                padding: 0.6rem 1.25rem;
                color: var(--color-texto);
                font-weight: 700;
                cursor: pointer;
            }

            .table-cute {
                width: 100%;
                border-collapse: separate;
                border-spacing: 0 0.75rem;
            }

                .table-cute thead th {
                    background-color: var(--color-azul-claro);
                    color: var(--color-texto);
                    font-weight: 700;
                    font-size: 0.8rem;
                    text-transform: uppercase;
                    padding: 0.85rem 1rem;
                    border: none;
                    border-radius: 12px;
                }

                .table-cute tbody tr {
                    background-color: white;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
                }

                .table-cute tbody td {
                    padding: 0.85rem 1rem;
                    vertical-align: middle;
                    border: none;
                    font-size: 0.9rem;
                }

                    .table-cute tbody td:first-child {
                        border-radius: 12px 0 0 12px;
                    }

                    .table-cute tbody td:last-child {
                        border-radius: 0 12px 12px 0;
                    }

            .badge-cute {
                padding: 0.35rem 0.75rem;
                border-radius: 50px;
                font-size: 0.75rem;
                font-weight: 700;
            }

            .badge-cute-warning {
                background-color: #fef3c7;
                color: #92400e;
            }

            .badge-cute-info {
                background-color: var(--color-azul-claro);
                color: #1e5a73;
            }

            .badge-cute-success {
                background-color: var(--color-verde-claro);
                color: #3f4d12;
            }

            .form-control, .form-select {
                border-radius: 12px;
                border: 2px solid var(--color-azul-claro);
                padding: 0.6rem 1rem;
            }

                .form-control:focus, .form-select:focus {
                    border-color: var(--color-aqua);
                    box-shadow: 0 0 0 0.2rem rgba(132, 191, 147, 0.25);
                }

            .modal-content {
                border-radius: 24px;
                border: none;
                background: rgba(255,255,255,0.98);
            }

            .modal-header {
                border-bottom: 2px solid var(--color-azul-claro);
                padding: 1.5rem 2rem;
            }

            .modal-title {
                font-weight: 800;
                color: var(--color-verde);
            }

            .modal-body {
                padding: 2rem;
            }

            .modal-footer {
                border-top: 2px solid var(--color-azul-claro);
                padding: 1.5rem 2rem;
            }

            /* --- Simulación de producción --- */
            .sim-icon-wrap {
                width: 90px;
                height: 90px;
                margin: 0 auto 1.25rem;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(135deg, var(--color-verde) 0%, var(--color-aqua) 100%);
                box-shadow: 0 8px 20px rgba(154, 191, 23, 0.35);
            }

                .sim-icon-wrap i {
                    font-size: 2.5rem;
                    color: white;
                }

                .sim-icon-wrap.spin i {
                    animation: sim-spin 0.9s linear infinite;
                }

            @@keyframes sim-spin {
                from {
                    transform: rotate(0deg);
                }

                to {
                    transform: rotate(360deg);
                }
            }

            .sim-progress {
                height: 14px;
                border-radius: 50px;
                background-color: var(--color-azul-claro);
                overflow: hidden;
                margin-bottom: 1rem;
            }

                .sim-progress .sim-progress-bar {
                    height: 100%;
                    width: 0%;
                    border-radius: 50px;
                    background: linear-gradient(135deg, var(--color-verde) 0%, var(--color-aqua) 100%);
                    transition: width 0.35s ease;
                }

            .sim-step-list {
                list-style: none;
                padding: 0;
                margin: 0;
            }

                .sim-step-list li {
                    display: flex;
                    align-items: center;
                    gap: 0.6rem;
                    padding: 0.4rem 0;
                    font-size: 0.9rem;
                    color: var(--color-texto-claro);
                }

                    .sim-step-list li .sim-step-icon {
                        width: 22px;
                        text-align: center;
                        flex-shrink: 0;
                    }

                    .sim-step-list li.sim-step-active {
                        color: var(--color-texto);
                        font-weight: 700;
                    }

                    .sim-step-list li.sim-step-done {
                        color: var(--color-verde);
                    }

            /* --- Alerta de stock insuficiente / compra automática --- */
            .alert-faltantes {
                margin-top: 0.5rem;
                background-color: #fef3c7;
                border-radius: 16px;
                padding: 1rem 1.25rem;
            }

            .lista-faltantes {
                margin: 0 0 1rem;
                padding-left: 1.2rem;
                font-size: 0.85rem;
                color: #92400e;
            }

                .lista-faltantes li {
                    margin-bottom: 0.2rem;
                }

            .btn-cute-sm {
                padding: 0.45rem 1rem;
                font-size: 0.85rem;
            }
    </style>
</head>
<body>
    <div class="dashboard-wrapper">
        @await Html.PartialAsync("_Sidebar")
        <main class="main-content">
            <div class="content-card">
                <div class="card-header-custom">
                    <h3><i class="bi bi-gear-wide-connected"></i> Órdenes de Producción</h3>
                    <button class="btn-cute-primary" onclick="abrirModalNueva()">
                        <i class="bi bi-plus-lg"></i> Nueva Orden
                    </button>
                </div>

               

                <div class="table-responsive">
                    <table class="table-cute">
                        <thead>
                            <tr>
                                <th>N° OP</th>
                                <th>Producto</th>
                                <th class="text-center">Cantidad</th>
                                <th>OC Vinculada</th>
                                <th>Estado</th>
                                <th>Fecha</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="bodyOrdenes">
                            <tr><td colspan="7" class="text-center text-muted py-4">Cargando...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </main>
    </div>

    <!-- MODAL NUEVA ORDEN -->
    <div class="modal fade" id="modalNueva" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-circle-fill"></i> Nueva Orden de Producción</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Producto a Fabricar</label>
                        <select class="form-select" id="nProductoId"></select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cantidad a Producir</label>
                        <input type="number" class="form-control" id="nCantidad" min="1" value="1">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Vincular a OC (Opcional, para trazabilidad)</label>
                        <input type="text" class="form-control" id="nNumeroOC" placeholder="Ej. OC-20260903-ABC123">
                        <small class="text-muted">Si la dejas vacía, se marcará como "Manual".</small>
                    </div>

                    <!-- Se muestra solo cuando el inventario no alcanza para fabricar -->
                    <div id="alertFaltantes" class="d-none">
                        <div class="alert-faltantes">
                            <p class="mb-2 fw-bold text-warning-emphasis">
                                <i class="bi bi-exclamation-triangle-fill"></i> Stock insuficiente para producir
                            </p>
                            <ul id="listaFaltantes" class="lista-faltantes"></ul>
                            <div class="mb-2">
                                <label class="form-label small mb-1">Proveedor para la orden de compra</label>
                                <select class="form-select form-select-sm" id="faltanteProveedorId"></select>
                            </div>
                            <button type="button" class="btn-cute-primary btn-cute-sm w-100" onclick="crearOCAutomatica()">
                                <i class="bi bi-cart-plus-fill"></i> Generar Orden de Compra automática
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn-cute-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button class="btn-cute-primary" id="btnCrearOrden" onclick="guardarOrden()"><i class="bi bi-save-fill"></i> Crear</button>
                </div>
            </div>
        </div>
    </div>

    
    <!-- MODAL DE SIMULACIÓN DE PRODUCCIÓN (TIEMPO REAL) -->
<div class="modal fade" id="modalSimulacion" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--color-verde) 0%, var(--color-aqua) 100%); color: white; border-radius: 24px 24px 0 0;">
                <h5 class="modal-title"><i class="bi bi-cpu-fill"></i> Producción: <span id="simModalNumeroOP"></span></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row align-items-center">
                    <div class="col-md-4 text-center mb-3 mb-md-0">
                        <img id="simModalImagen" src="" alt="Producto" class="img-fluid rounded-4 shadow-sm" style="max-height: 180px; object-fit: cover;">
                        <h5 class="mt-3 mb-0 fw-bold" id="simModalProducto">Producto</h5>
                        <span class="badge-cute badge-cute-info mt-2 d-inline-block" id="simModalTiempo">Calculando...</span>
                    </div>
                    <div class="col-md-8">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-bold" style="color: var(--color-verde)" id="simModalEstadoTexto">Ensamblaje en progreso</span>
                            <span class="fw-bold" id="simModalPorcentaje">0%</span>
                        </div>
                        <div class="sim-progress mb-4" style="height: 24px;">
                            <div class="sim-progress-bar" id="simModalProgressBar" style="width: 0%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 800;">0%</div>
                        </div>
                        
                        <div class="d-flex align-items-center gap-3 p-3 rounded-4" style="background-color: var(--color-azul-claro);">
                            <div class="sim-icon-wrap spin" id="simModalIconoWrap" style="width: 60px; height: 60px; margin: 0; flex-shrink: 0;">
                                <i class="bi bi-fan" style="font-size: 1.5rem;"></i>
                            </div>
                            <div>
                                <h6 class="mb-1 fw-bold" id="simModalPasoActual">Iniciando preparación...</h6>
                                <small class="text-muted">El sistema descuenta e inventaría automáticamente al llegar al 100%.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    <script>
    // ==========================================
    // VARIABLES GLOBALES
    // ==========================================
    let modalNueva, modalSimulacion;
    let pollingInterval = null;
    let currentMonitoredOrderId = null;

    const PASOS_SIMULACION = [
        'Verificando componentes en inventario',
        'Ubicando motor y base',
        'Colocando aspas del ventilador',
        'Ensamblando carcasa protectora',
        'Conectando cableado y batería',
        'Control de calidad y pruebas',
        'Empaquetado y actualización de inventario'
    ];

    // ==========================================
    // INICIALIZACIÓN
    // ==========================================
    $(function() {
        modalNueva = new bootstrap.Modal(document.getElementById('modalNueva'));
        modalSimulacion = new bootstrap.Modal(document.getElementById('modalSimulacion'));
        
        // Detener el polling si el usuario cierra el modal manualmente
        document.getElementById('modalSimulacion').addEventListener('hidden.bs.modal', function () {
            detenerMonitoreo();
        });

        cargarProductos();
        cargarOrdenes();
        cargarProveedoresFaltantes();
    });

    // ==========================================
    // CARGA DE DATOS
    // ==========================================
    function cargarProveedoresFaltantes() {
        $.get('/Proveedor/consultar-proveedores', function(r) {
            if (r.success) {
                var sel = $('#faltanteProveedorId');
                sel.empty();
                $.each(r.result, function(i, p) { sel.append(`<option value="${p.id}">${p.nombre}</option>`); });
            }
        });
    }

    function cargarProductos() {
        $.get('/Produccion/obtener-productos', function(r) {
            if (r.success) {
                var sel = $('#nProductoId');
                sel.empty();
                $.each(r.result, function(i, p) { sel.append(`<option value="${p.id}">${p.nombre}</option>`); });
            }
        });
    }

    function cargarOrdenes() {
        $.get('/Produccion/consultar-ordenes', function(r) {
            var tbody = $('#bodyOrdenes');
            tbody.empty();
            if (!r.success || !r.result || !r.result.length) {
                tbody.html('<tr><td colspan="7" class="text-center text-muted py-4">Sin órdenes de producción</td></tr>');
                return;
            }
            
            $.each(r.result, function(i, o) {
                let badgeClass = o.estado === 'Pendiente' ? 'badge-cute-warning' : 
                                 o.estado === 'Pausada' ? 'badge-cute-warning' : 
                                 o.estado === 'EnProceso' ? 'badge-cute-info' : 'badge-cute-success';
                
                let acciones = '';
                if (o.estado === 'Pendiente') {
                    acciones = `<button class="btn-cute-secondary btn-cute-sm me-1" onclick="iniciarProduccion(${o.id})"><i class="bi bi-play-fill"></i> Iniciar</button>`;
                } else if (o.estado === 'EnProceso') {
                    acciones = `
                        <button class="btn-cute-secondary btn-cute-sm me-1" onclick="pausarProduccion(${o.id})"><i class="bi bi-pause-fill"></i> Pausar</button>
                        <button class="btn-cute-primary btn-cute-sm" onclick="verSimulacion(${o.id})"><i class="bi bi-eye-fill"></i> Ver</button>`;
                } else if (o.estado === 'Pausada') {
                    acciones = `
                        <button class="btn-cute-secondary btn-cute-sm me-1" onclick="reanudarProduccion(${o.id})"><i class="bi bi-play-fill"></i> Reanudar</button>
                        <button class="btn-cute-primary btn-cute-sm" onclick="verSimulacion(${o.id})"><i class="bi bi-eye-fill"></i> Ver</button>`;
                } else {
                    acciones = '<span class="text-muted small">Finalizada</span>';
                }

                tbody.append(`
                    <tr id="fila-op-${o.id}">
                        <td><strong>${o.numeroOP}</strong></td>
                        <td>${o.producto}</td>
                        <td class="text-center">${o.cantidad} uds</td>
                        <td>${o.numeroOC}</td>
                        <td><span class="badge-cute ${badgeClass}">${o.estado}</span></td>
                        <td>${new Date(o.fechaCreacion).toLocaleDateString()}</td>
                        <td class="text-center">${acciones}</td>
                    </tr>
                `);
            });
        });
    }

    // ==========================================
    // GESTIÓN DE ÓRDENES (Crear, Iniciar, Pausar, Reanudar)
    // ==========================================
    function abrirModalNueva() {
        $('#nCantidad').val(1); $('#nNumeroOC').val(''); ocultarFaltantes();
        modalNueva.show();
    }

    function guardarOrden() {
        var data = { ProductoId: parseInt($('#nProductoId').val()), Cantidad: parseInt($('#nCantidad').val()), OrdenCompraId: null };
        if (!data.ProductoId || !data.Cantidad) { showToast('Completa los campos obligatorios', 'warning'); return; }
        ocultarFaltantes();

        $.ajax({
            url: '/Produccion/generar-orden', type: 'POST', contentType: 'application/json', data: JSON.stringify(data),
            success: function(r) {
                if (!r.success) { r.stockInsuficiente ? mostrarFaltantes(r) : showToast(r.mensaje, 'danger'); return; }
                showToast(r.mensaje, 'success'); modalNueva.hide(); cargarOrdenes();
            }
        });
    }

    function mostrarFaltantes(r) {
        var lista = $('#listaFaltantes'); lista.empty();
        $.each(r.componentesFaltantes, function(i, c) {
            lista.append(`<li>${c.nombre}: faltan <strong>${c.faltante}</strong> (disp: ${c.disponible} / req: ${c.requerido})</li>`);
        });
        $('#alertFaltantes').data('producto-id', r.productoId).data('cantidad', r.cantidad).removeClass('d-none');
    }
    function ocultarFaltantes() { $('#alertFaltantes').addClass('d-none'); $('#listaFaltantes').empty(); }

    function crearOCAutomatica() {
        var proveedorId = parseInt($('#faltanteProveedorId').val());
        if (!proveedorId) { showToast('Selecciona un proveedor', 'warning'); return; }
        var data = {
            ProductoId: $('#alertFaltantes').data('producto-id'),
            Cantidad: $('#alertFaltantes').data('cantidad'),
            ProveedorId: proveedorId,
            FechaEsperada: new Date(Date.now() + 7*24*60*60*1000).toISOString()
        };
        $.ajax({
            url: '/OrdenesCompra/guardar-orden', type: 'POST', contentType: 'application/json', data: JSON.stringify(data),
            success: function(r) {
                if (!r.success) { showToast(r.mensaje, 'danger'); return; }
                showToast(r.mensaje, 'success'); modalNueva.hide();
            }
        });
    }

    function iniciarProduccion(id) {
        $.post('/Produccion/iniciar/' + id, function(r) {
            r.success ? (showToast(r.mensaje, 'success'), cargarOrdenes(), verSimulacion(id)) : showToast(r.mensaje, 'danger');
        });
    }

    function pausarProduccion(id) {
        $.post('/Produccion/pausar/' + id, function(r) {
            r.success ? (showToast(r.mensaje, 'warning'), cargarOrdenes()) : showToast(r.mensaje, 'danger');
        });
    }

    function reanudarProduccion(id) {
        $.post('/Produccion/reanudar/' + id, function(r) {
            r.success ? (showToast(r.mensaje, 'success'), cargarOrdenes(), verSimulacion(id)) : showToast(r.mensaje, 'danger');
        });
    }

    // ==========================================
    // SIMULACIÓN EN TIEMPO REAL (MODAL)
    // ==========================================
    function verSimulacion(id) {
        currentMonitoredOrderId = id;
        modalSimulacion.show();
        
        if (pollingInterval) clearInterval(pollingInterval);
        
        consultarProgresoBackend(); // Ejecutar inmediatamente
        pollingInterval = setInterval(consultarProgresoBackend, 3000); // Consultar cada 3 segundos
    }

    function detenerMonitoreo() {
        if (pollingInterval) {
            clearInterval(pollingInterval);
            pollingInterval = null;
        }
        currentMonitoredOrderId = null;
    }

    function consultarProgresoBackend() {
    if (!currentMonitoredOrderId) return;

    $.get(`/Produccion/progreso/${currentMonitoredOrderId}`, function(r) {
        if (!r.success) return;
        const data = r.result;

        // Actualizar UI del Modal
        $('#simModalNumeroOP').text(data.numeroOP);
        $('#simModalProducto').text(data.productoNombre);
        $('#simModalImagen').attr('src', data.productoImagen);
        $('#simModalTiempo').text(data.tiempoRestanteTexto);

        const pct = data.progreso;
        $('#simModalProgressBar').css('width', pct + '%').text(Math.round(pct) + '%');
        $('#simModalPorcentaje').text(Math.round(pct) + '%');

        const pasoIndex = Math.max(0, data.pasoActual - 1);
        $('#simModalPasoActual').text(PASOS_SIMULACION[pasoIndex]);

        if (data.estadoSimulacion === 'Pausada') {
            $('#simModalEstadoTexto').text('⏸ Producción Pausada').css('color', '#d97706');
            $('#simModalIconoWrap').removeClass('spin');
        } else if (data.estadoSimulacion === 'EnProceso') {
            $('#simModalEstadoTexto').text('▶ Ensamblaje en progreso').css('color', 'var(--color-verde)');
            $('#simModalIconoWrap').addClass('spin');
        }

        // 🔥 SEGURO DE VIDA: Si llega a 100% pero el servidor no lo ha marcado como Completada, ¡FORZAMOS!
        if (pct >= 100 && data.estadoSimulacion !== 'Completada') {
            console.warn("⚠️ Progreso al 100% pero estado no es 'Completada'. Forzando actualización desde frontend...");
            forzarCompletado(data.ordenId);
            return; // Salimos para no seguir consultando
        }

        // Si el backend ya la marcó como completada, el frontend solo celebra y cierra
        if (data.estadoSimulacion === 'Completada') {
            detenerMonitoreo(); 
            $('#simModalEstadoTexto').text('✅ Producción Completada').css('color', 'var(--color-verde)');
            $('#simModalIconoWrap').removeClass('spin');
        
            setTimeout(() => {
                modalSimulacion.hide();
                showToast('¡Producción finalizada e inventario actualizado!', 'success');
                cargarOrdenes();
            }, 1500);
        }
    }).fail(function() {
        console.log("Error de conexión temporal, el servidor sigue procesando la orden.");
    });
}
    // NUEVA FUNCIÓN: Fuerza la llamada al Controller para asegurar el descuento de inventario
    function forzarCompletado(id) {
        $.ajax({
            url: '/Produccion/completar/' + id,
            type: 'POST',
            success: function(r) {
                if (r.success) {
                    showToast('Inventario actualizado correctamente', 'success');
                    detenerMonitoreo();
                    modalSimulacion.hide();
                    cargarOrdenes();
                } else {
                    showToast('Error al actualizar inventario: ' + r.mensaje, 'danger');
                }
            },
            error: function() {
                showToast('Error de conexión al completar la producción', 'danger');
            }
        });
    }

    // ==========================================
    // UTILIDADES
    // ==========================================
    function showToast(mensaje, tipo) {
        let container = document.getElementById('toast-container');
        if (!container) {
            container = document.createElement('div');
            container.id = 'toast-container';
            container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            container.style.zIndex = '9999';
            document.body.appendChild(container);
        }
        const bg = tipo === 'success' ? 'bg-success' : tipo === 'danger' ? 'bg-danger' : 'bg-warning';
        const text = tipo === 'warning' ? 'text-dark' : 'text-white';
        const id = 'toast-' + Date.now();
        
        container.insertAdjacentHTML('beforeend', `
            <div id="${id}" class="toast align-items-center ${bg} ${text} border-0 shadow-lg" role="alert" style="border-radius:16px;">
                <div class="d-flex">
                    <div class="toast-body fw-semibold">${mensaje}</div>
                    <button type="button" class="btn-close ${tipo === 'warning' ? '' : 'btn-close-white'} me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>`);
        
        const toast = new bootstrap.Toast(document.getElementById(id), { delay: 3500 });
        toast.show();
        document.getElementById(id).addEventListener('hidden.bs.toast', (e) => e.target.remove());
    }
</script>
</body>
</html>